    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prépare la notification Ken et la mise à jour Sheets\nconst reponse = $input.all()[0]?.json || {};\nconst prospect = $input.all()[1]?.json || {};\n\nconst nom = prospect.Nom || reponse.from || 'Inconnu';\nconst ville = prospect.Ville || '';\nconst secteur = prospect.Secteur || '';\nconst type = reponse.type_reponse || 'MESSAGE';\nconst canal = reponse.canal || 'WHATSAPP';\nconst message = reponse.message || '';\nconst interet = reponse.interet || false;\n\nlet emoji = '💬';\nlet nouveauStatut = 'RÉPONDU';\nif (type === 'INTERET') { emoji = '🔥'; nouveauStatut = 'INTERET'; }\nelse if (type === 'REFUS') { emoji = '❌'; nouveauStatut = 'REFUS'; }\nelse if (type === 'QUESTION_PRIX') { emoji = '💰'; nouveauStatut = 'INTERET'; }\nelse if (type === 'QUESTION_DELAI') { emoji = '⏱️'; nouveauStatut = 'INTERET'; }\n\nconst notifKen = `${emoji} *Réponse ${canal}*\n\n*Prospect :* ${nom}${ville ? ' — ' + ville : ''}${secteur ? ' (' + secteur + ')' : ''}\n*Type :* ${type}\n*Message :*\n\"${message.substring(0, 300)}\"\n\n${interet ? '→ APPELLE-LE / ENVOIE LA PROPOSITION !' : '→ Archiver ou ignorer.'}`;\n\nreturn [{\n  json: {\n    ...reponse,\n    prospect_nom: nom,\n    prospect_ville: ville,\n    prospect_secteur: secteur,\n    nouveau_statut: nouveauStatut,\n    notification_ken: notifKen,\n    interet: interet\n  }\n}];"
      },
