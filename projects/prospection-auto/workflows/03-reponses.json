      "id": "c1b2c3d4-0002-0002-0002-000000000002",
      "name": "Webhook Email Entrant",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        420
      ],
      "webhookId": "email-inbound-ken"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse la réponse WhatsApp de Twilio\nconst body = $json.body || $json;\nconst from = (body.From || '').replace('whatsapp:', '').trim();\nconst messageBody = (body.Body || '').trim();\nconst profileName = body.ProfileName || '';\n\n// Détecte le type de réponse\nconst msgLower = messageBody.toLowerCase();\nlet typeReponse = 'AUTRE';\nlet interet = false;\n\nif (msgLower.includes('oui') || msgLower.includes('yes') || msgLower.includes('interesse') || msgLower.includes('intéressé') || msgLower.includes('ok') || msgLower.includes('d accord') || msgLower.includes('d\\'accord')) {\n  typeReponse = 'INTERET';\n  interet = true;\n} else if (msgLower.includes('non') || msgLower.includes('no') || msgLower.includes('stop') || msgLower.includes('pas interesse') || msgLower.includes('arrête')) {\n  typeReponse = 'REFUS';\n} else if (msgLower.includes('prix') || msgLower.includes('combien') || msgLower.includes('tarif') || msgLower.includes('coût') || msgLower.includes('cout')) {\n  typeReponse = 'QUESTION_PRIX';\n  interet = true;\n} else if (msgLower.includes('quand') || msgLower.includes('délai') || msgLower.includes('delai') || msgLower.includes('temps')) {\n  typeReponse = 'QUESTION_DELAI';\n  interet = true;\n} else if (messageBody.length > 3) {\n  typeReponse = 'MESSAGE';\n  interet = true;\n}\n\nreturn [{\n  json: {\n    canal: 'WHATSAPP',\n    from: from,\n    message: messageBody,\n    profile_name: profileName,\n    type_reponse: typeReponse,\n    interet: interet,\n    date_reponse: new Date().toISOString().split('T')[0],\n    heure_reponse: new Date().toTimeString().split(' ')[0]\n  }\n}];"
      },
      "id": "c1b2c3d4-0003-0003-0003-000000000003",
      "name": "Parser réponse WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse la réponse email\nconst body = $json.body || $json;\nconst from = body.from || body.sender || '';\nconst subject = body.subject || '';\nconst text = body.text || body.body || body.plain || '';\nconst html = body.html || '';\nconst content = (text || html).toLowerCase();\n\nlet typeReponse = 'AUTRE';\nlet interet = false;\n\nif (content.includes('oui') || content.includes('intéressé') || content.includes('interesse') || content.includes('proposition') || content.includes('rappeler') || content.includes('contact')) {\n  typeReponse = 'INTERET';\n  interet = true;\n} else if (content.includes('stop') || content.includes('désabonner') || content.includes('désinscrire') || content.includes('pas interesse') || content.includes('non merci')) {\n  typeReponse = 'REFUS';\n} else if (content.includes('prix') || content.includes('tarif') || content.includes('combien') || content.includes('devis')) {\n  typeReponse = 'QUESTION_PRIX';\n  interet = true;\n} else if (text.length > 10 || html.length > 50) {\n  typeReponse = 'MESSAGE';\n  interet = true;\n}\n\nreturn [{\n  json: {\n    canal: 'EMAIL',\n    from: from,\n    subject: subject,\n    message: text || 'voir HTML',\n    type_reponse: typeReponse,\n    interet: interet,\n    date_reponse: new Date().toISOString().split('T')[0],\n    heure_reponse: new Date().toTimeString().split(' ')[0]\n  }\n}];"
      },
      "id": "c1b2c3d4-0004-0004-0004-000000000004",
      "name": "Parser réponse Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
