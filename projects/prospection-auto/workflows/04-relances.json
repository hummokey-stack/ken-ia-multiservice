    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Calcule le nombre de jours depuis le contact initial\nconst p = $json;\nconst dateContact = p['Date Contact'] || '';\n\nif (!dateContact) {\n  return [{ json: { ...p, jours_ecoules: 0, doit_relancer: false } }];\n}\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst [year, month, day] = dateContact.split('-').map(Number);\nconst dc = new Date(year, month - 1, day);\ndc.setHours(0, 0, 0, 0);\n\nconst diff = Math.floor((today - dc) / (1000 * 60 * 60 * 24));\n\n// Relance à J+2 (1ère relance) ou J+5 (2ème relance)\nconst doit_relancer = diff === 2 || diff === 5;\nconst num_relance = diff === 2 ? 1 : (diff === 5 ? 2 : 0);\n\nreturn [{\n  json: {\n    ...p,\n    jours_ecoules: diff,\n    doit_relancer: doit_relancer,\n    num_relance: num_relance\n  }\n}];"
      },
      "id": "d1b2c3d4-0004-0004-0004-000000000004",
      "name": "Calculer jours depuis contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "cond-relance",
              "leftValue": "={{ $json.doit_relancer }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d1b2c3d4-0005-0005-0005-000000000005",
      "name": "Doit-on relancer ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $json;\nconst nom = p.Nom || 'votre établissement';\nconst secteur = (p.Secteur || '').toLowerCase();\nconst pays = p.Pays || 'France';\nconst numRelance = p.num_relance || 1;\nconst joursEcoules = p.jours_ecoules || 2;\n\nlet msgRelance = '';\n\nif (numRelance === 1) {\n  // J+2 : relance douce\n  msgRelance = `Bonjour,\\n\\nJe me permets de revenir vers vous concernant *${nom}*.\\n\\nIl y a quelques jours, je vous ai envoyé un message au sujet de votre présence en ligne. Je voulais juste m'assurer que vous l'avez bien reçu.\\n\\nSi vous êtes intéressé(e) par la création de votre site web, je suis disponible pour répondre à toutes vos questions. Une simple réponse *OUI* suffit pour recevoir votre proposition personnalisée gratuitement.\\n\\n— *Ken*\\nKEN Digital Innovations\\n📞 +237 654 270 447`;\n} else {\n  // J+5 : dernière chance\n  const urgence = pays === 'Cameroun' ? '120 000 FCFA' : '140€';\n  const prix = secteur.includes('restaurant') || secteur.includes('ristorante') || secteur.includes('restaurante')\n    ? (pays === 'Cameroun' ? '150 000 FCFA' : '150€')\n    : secteur.includes('coiffure') || secteur.includes('salon') || secteur.includes('parrucchiere') || secteur.includes('peluqueria')\n    ? (pays === 'Cameroun' ? '100 000 FCFA' : '120€')\n    : urgence;\n\n  msgRelance = `Bonjour,\\n\\nC'est mon dernier message concernant *${nom}*.\\n\\nJe vous propose toujours un site web professionnel à partir de *${prix}*, livré en 7 jours.\\n\\n⚡ *Offre valable cette semaine uniquement* — Je prends en ce moment peu de nouveaux clients pour garantir la qualité.\\n\\nSi vous êtes intéressé(e), répondez *OUI* maintenant. Sinon, je ne vous contacterai plus.\\n\\nBonne continuation,\\n— *Ken*\\nKEN Digital Innovations\\n📞 +237 654 270 447`;\n}\n\nreturn [{\n  json: {\n    ...p,\n    message_relance: msgRelance\n  }\n}];"
      },
